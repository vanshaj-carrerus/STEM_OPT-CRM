MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=stem_opt_crm
APP_SECRET=generate-48+random-bytes-e.g.-node-e-"console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_URL=https://crm.yourcompany.com
EMAIL_USER=your.sender@gmail.com
# Google APP PASSWORD (16 letters from https://myaccount.google.com/apppasswords) — not your normal password. EMAIL_PASSWORD also works.
EMAIL_PASS=gmail-app-password
DOCS_DIR=./.data/documents
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator
# Bearer token for POST /api/cron/tick (serverless schedulers); 16+ chars. Leave unset to disable the endpoint.
CRON_SECRET=

# Shared secret for verifying Gusto webhook signatures (POST /api/integrations/gusto/webhook); 16+ chars. Unset = endpoint rejects all calls.
GUSTO_WEBHOOK_SECRET=

# Ria / bank webhook secrets (optional; callbacks are ignored until Ria automation is approved in Admin settings)
RIA_WEBHOOK_SECRET=
BANK_WEBHOOK_SECRET=
